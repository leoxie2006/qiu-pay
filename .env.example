# 数据库配置
DB_PATH=data/qiupay.db

# 管理员默认账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# JWT 密钥（生产环境务必修改）
JWT_SECRET=change-me-to-a-random-secret-key

# 后端配置
BACKEND_HOST=localhost
BACKEND_PORT=8000

# 前端配置（开发模式）
FRONTEND_HOST=localhost
FRONTEND_PORT=5173

# CORS 跨域配置（开发环境启用）
CORS_ENABLED=1
CORS_ORIGINS=http://localhost:5173

# 主机时区文件（仅用于 Compose 插值；不存在时显式指定有效文件）
HOST_TIMEZONE_FILE=/etc/localtime

# Compose 推荐镜像；生产建议固定已验证的 GHCR digest
QIUPAY_IMAGE=ghcr.io/leoxie2006/qiu-pay:latest
